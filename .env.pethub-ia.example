# Acrescente ao ambiente existente. NÃO substitua o .env do ERP/WhatsApp.
# Módulo e atendimento real DESLIGADOS nesta entrega.
PETHUB_IA_ENABLED=false
PETHUB_IA_ALLOW_LIVE=false
# Chave central exclusivamente no servidor; nunca no frontend.
OPENAI_API_KEY=
# Gerar uma vez, guardar com os backups. 32 bytes aleatórios em base64.
PETHUB_IA_ENCRYPTION_KEY=
OPENAI_REQUEST_TIMEOUT=30000
PETHUB_IA_CONCURRENCY=2
# Só autorizar um modelo de áudio realmente testado e tarifado no Admin.
OPENAI_TRANSCRIPTION_MODEL=
PETHUB_IA_FFPROBE=ffprobe
# Alternativa oficial EM HOMOLOGAÇÃO; atendimento automático bloqueado.
# Não preencher para utilizar a conexão atual do ERP.
META_GRAPH_VERSION=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
# Credenciais de banco, JWT, WhatsApp e VAPID continuam no ambiente atual.
