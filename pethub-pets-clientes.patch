+              <div style="font-size:20px; font-weight:700; color:#dc2626; margin-top:2px;">R$ ${formatarMoeda(saldoCrediario)}</div>
+            </div>
+          </div>
+        </div>`;
+    }
+
+    cardsContainer.innerHTML = html;
+  } catch (e) {
+    console.warn("Erro ao atualizar cards financeiros:", e);
+  }
+}
