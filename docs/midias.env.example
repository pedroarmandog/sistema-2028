# Acrescente ao .env local ou ao Environment do Render. Não substitua outras variáveis.
# Use valores reais obtidos no painel R2; nunca envie os segredos ao GitHub.
MEDIA_S3_BUCKET=pethub-midias
MEDIA_S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=SUBSTITUA_PELO_ACCESS_KEY_ID
MEDIA_S3_SECRET_ACCESS_KEY=SUBSTITUA_PELO_SECRET_ACCESS_KEY
# Opcionais somente para migração/importação controlada:
# MEDIA_LEGACY_ROOT=C:\backup\uploads
# MEDIA_MIGRATION_HOSTS=pethub-api-wdna.onrender.com
# MEDIA_LEGACY_BASE_URL=https://pethub-api-wdna.onrender.com
# MEDIA_IMPORT_HOSTS=imagens.seu-fornecedor.com.br
