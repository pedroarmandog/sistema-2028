# Somente no backend (.env local ou Environment do Render).
# Acrescente; não substitua seu .env e não versionar valores reais.
FOCUS_NFE_MASTER_TOKEN=SUBSTITUA_PELO_TOKEN_MASTER_DA_FOCUS
# IDs reais da tabela admins; não são IDs de empresas ou de usuários ERP.
FOCUS_NFE_DIAGNOSTIC_ADMIN_IDS=SUBSTITUA_PELOS_IDS_ADMINISTRATIVOS_AUTORIZADOS
# JWT_SECRET administrativo já existente deve continuar configurado e forte.
# Os tokens de emissão das empresas permanecem no cadastro fiscal, separados.
